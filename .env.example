# Copy to `mycoguard/.env` (gitignored) or rely on the shared parent
# `projects/.env`. Keys are read by the FastAPI backend ONLY — never by the
# browser. All values are optional: without keys the app runs fully offline
# (rule engine + knowledge-base chat).

# --- Vision analysis (阿里云百炼 / DashScope, OpenAI-compatible) ---
DASHSCOPE_API_KEY=
DASHSCOPE_OPENAI_COMPAT_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- Chat enhancement (DeepSeek, OpenAI-compatible) ---
DEEPSEEK_API_KEY=
# DEEPSEEK_OPENAI_COMPAT_URL=https://api.deepseek.com/v1

# --- Optional model overrides ---
# MYCOGUARD_VISION_MODEL=qwen-vl-plus
# MYCOGUARD_CHAT_MODEL=deepseek-chat
